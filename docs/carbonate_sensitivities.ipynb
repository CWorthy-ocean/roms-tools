   "source": [
    "eta_beta.ds_surface_control.isel({\"time\":tind})['salt'].plot();"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a6b01a68-b782-4d84-95dc-21d9a86a8ece",
   "metadata": {},
   "outputs": [
